# Leave a value blank to keep that integration in simulated mode. Placeholder values
# (your-..., ...@yourdomain.com, /path/to/...) are also treated as blank.

# Jira API Configuration
# e.g. JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_BASE_URL=
# e.g. JIRA_EMAIL=your-email@domain.com
JIRA_EMAIL=
# e.g. JIRA_API_TOKEN=your-jira-api-token
JIRA_API_TOKEN=

# GitHub API Configuration
# e.g. GITHUB_TOKEN=your-github-personal-access-token
GITHUB_TOKEN=
# e.g. GITHUB_OWNER=your-github-username-or-org
GITHUB_OWNER=
# e.g. GITHUB_REPO=your-github-repo-name
GITHUB_REPO=

# Jenkins Configuration
JENKINS_URL=http://localhost:8080
# e.g. JENKINS_USER=your-jenkins-user
JENKINS_USER=
# e.g. JENKINS_TOKEN=your-jenkins-api-token
JENKINS_TOKEN=

# Octopus Deploy Configuration
OCTOPUS_URL=http://localhost:8085
# e.g. OCTOPUS_API_KEY=your-octopus-api-key
OCTOPUS_API_KEY=

# CRM Configuration
# e.g. CRM_BASE_URL=https://crm.yourdomain.local
CRM_BASE_URL=
# e.g. CRM_API_KEY=your-crm-api-key
CRM_API_KEY=

# ITSM Configuration
# e.g. ITSM_BASE_URL=https://itsm.yourdomain.local
ITSM_BASE_URL=
# e.g. ITSM_API_KEY=your-itsm-api-key
ITSM_API_KEY=

# Zoho Cliq Configuration (OAuth self-client - posts to the "Code Red - Internal" channel)
# e.g. ZOHO_CLIENT_ID=your-zoho-self-client-id
ZOHO_CLIENT_ID=
# e.g. ZOHO_CLIENT_SECRET=your-zoho-self-client-secret
ZOHO_CLIENT_SECRET=
# e.g. ZOHO_REFRESH_TOKEN=your-zoho-oauth-refresh-token
ZOHO_REFRESH_TOKEN=
ZOHO_CLIQ_DOMAIN=cliq.zoho.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# JIRA "Push to QA" - default fallback assignee if no QA_ASSIGNEE_n_* below are set
# e.g. PUSH_TO_QA_ASSIGNEE_EMAIL=qa-lead@yourdomain.com
PUSH_TO_QA_ASSIGNEE_EMAIL=
PUSH_TO_QA_ASSIGNEE_NAME=QA

# Everything below is also editable from the in-app "Team Contacts" page (Settings > Team
# Contacts) - no restart needed, changes there rewrite these lines directly. Add/remove
# numbered entries freely; there's no fixed slot cap.

# Push to QA - who tickets can be reassigned to (radio choice on the Push to QA page)
QA_ASSIGNEE_1_NAME=QA Lead One
# e.g. QA_ASSIGNEE_1_EMAIL=qa-lead-1@yourdomain.com
QA_ASSIGNEE_1_EMAIL=
QA_ASSIGNEE_2_NAME=QA Lead Two
# e.g. QA_ASSIGNEE_2_EMAIL=qa-lead-2@yourdomain.com
QA_ASSIGNEE_2_EMAIL=

# Open PR Dashboard "Approval" button - peers pinged via Cliq direct message
APPROVAL_PEER_1_NAME=Peer One
# e.g. APPROVAL_PEER_1_EMAIL=peer1@yourdomain.com
APPROVAL_PEER_1_EMAIL=
APPROVAL_PEER_2_NAME=Peer Two
# e.g. APPROVAL_PEER_2_EMAIL=peer2@yourdomain.com
APPROVAL_PEER_2_EMAIL=
APPROVAL_PEER_3_NAME=Peer Three
# e.g. APPROVAL_PEER_3_EMAIL=peer3@yourdomain.com
APPROVAL_PEER_3_EMAIL=

# Open PR Dashboard "Review" button - who gets pinged to review
PR_REVIEWER_NAME=Reviewer Name
# e.g. PR_REVIEWER_EMAIL=reviewer@yourdomain.com
PR_REVIEWER_EMAIL=

# Ticket Delivery (JIRA Integration > Ticket Delivery) - sprint tickets handed off to Claude per stage
DELIVERY_JIRA_PROJECT_KEYS=RNMS
# Board id pins the exact active / next sprint (otherwise openSprints()/futureSprints())
DELIVERY_JIRA_BOARD_ID=
DELIVERY_ONLY_MINE=true
# Hide sub-tasks (e.g. "Development") - list parent tickets only
DELIVERY_EXCLUDE_SUBTASKS=true
DELIVERY_SPRINT_FIELD=customfield_10010
DELIVERY_STORY_POINTS_FIELD=customfield_10016
CLAUDE_BIN=claude
CLAUDE_SKILL=rn-ticket-delivery
CLAUDE_DESIGN_URL=https://claude.ai
# Terminal for "Open in Claude Code" - {cmd} is replaced by the command. Blank = Terminal.app (macOS) / x-terminal-emulator (Linux)
# DELIVERY_TERMINAL_CMD=gnome-terminal -- bash -lc {cmd}
# Local clone used for every project not in DELIVERY_REPO_MAP (GitHub repo falls back to GITHUB_OWNER/GITHUB_REPO)
# e.g. DELIVERY_REPO_PATH=/path/to/your/local/clone
DELIVERY_REPO_PATH=
# Per Jira project, one line of JSON:
# DELIVERY_REPO_MAP={"RNMS":{"path":"/code/app","owner":"uktech","repo":"app","sit_branch":"sit","main_branch":"main"}}
# My Tickets (landing page) lists tickets via Claude Code's Atlassian MCP. MCP server names from `claude mcp list`.
CLAUDE_JIRA_MCP_SERVERS=atlassian,Atlassian,claude_ai_Atlassian,Atlassian_Rovo
# Post "<stage> checklist complete" to Code Red - Internal on Cliq
DELIVERY_CLIQ_NOTIFY=false

# General Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./dev_portal.db
