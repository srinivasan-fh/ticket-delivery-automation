# --- Dashboard ---
PORT=4600
# DATA_DIR=.tda

# --- Jira (https://id.atlassian.com/manage-profile/security/api-tokens) ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=RNMS
# Board id pins the exact active and next sprint; without it, openSprints()/futureSprints() are used.
JIRA_BOARD_ID=
# Only tickets assigned to you (set to false for the whole team)
JIRA_ONLY_MINE=true
# JIRA_SPRINT_FIELD=customfield_10020
# JIRA_STORY_POINTS_FIELD=customfield_10016

# --- Claude ---
CLAUDE_BIN=claude
CLAUDE_SKILL=rn-ticket-delivery
CLAUDE_DESIGN_URL=https://claude.ai
# Terminal used for "Open in Claude Code". Defaults: macOS Terminal.app, Linux x-terminal-emulator.
# {cmd} is replaced by the shell command, e.g. for iTerm/gnome-terminal:
# TERMINAL_CMD=gnome-terminal -- bash -lc {cmd}

# --- Repos ---
# Default local clone + GitHub repo, used when a project is not in REPO_MAP
REPO_PATH=/path/to/your/app
GITHUB_REPO=owner/repo
# Per Jira project (JSON, one line):
# REPO_MAP={"RNMS":{"path":"/code/app","github":"owner/app","sitBranch":"sit","mainBranch":"main"}}

# --- Dev Automation Portal (tags, PR reviews, Push to QA) ---
# https://github.com/anboli-foodhub/dev-automation-portal, started with ./start.sh
PORTAL_URL=http://localhost:5173
PORTAL_API_URL=http://127.0.0.1:8000/api

# --- Zoho Cliq (optional, stage-done updates; the portal sends PR/QA notifications) ---
ZOHO_CLIQ_WEBHOOK_URL=
