{
  "name": "dev-automation-portal",
  "version": "1.0.0",
  "description": "Developer Automation Portal Dashboard",
  "scripts": {
    "install:all": "npm install --prefix frontend && pip install -r backend/requirements.txt",
    "start:backend": "cd backend && venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "start:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently --kill-others \"npm run start:backend\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
